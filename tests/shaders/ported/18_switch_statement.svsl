// Switch statement test - exercises OpSwitch
struct VSOutput {
	float4 position : SV_Position;
	float4 color    : COLOR0;
};

cbuffer Params : register(b0) {
	int mode;
};

[vertex]
VSOutput main(uint vertexID : SV_VertexID) {
	VSOutput output;
	output.position = float4(0.0, 0.0, 0.0, 1.0);
	output.color = float4(1.0, 1.0, 1.0, 1.0);

	// Switch with multiple cases and default
	switch (mode) {
	case 0:
		output.color = float4(1.0, 0.0, 0.0, 1.0); // Red
		break;
	case 1:
		output.color = float4(0.0, 1.0, 0.0, 1.0); // Green
		break;
	case 2:
		output.color = float4(0.0, 0.0, 1.0, 1.0); // Blue
		break;
	case 3:
	case 4:
		// Fall-through case: yellow for 3 or 4
		output.color = float4(1.0, 1.0, 0.0, 1.0);
		break;
	default:
		output.color = float4(0.5, 0.5, 0.5, 1.0); // Gray
		break;
	}

	return output;
}
