// Control flow tests - if/else, for, while
struct PSInput {
	float4 position : SV_Position;
	float2 texcoord : TEXCOORD0;
};

cbuffer Params : register(b0) {
	float threshold;
	int   iterations;
};

[fragment]
float4 main(PSInput input) : SV_Target {
	float4 color = float4(0.0, 0.0, 0.0, 1.0);

	// If/else test
	if (input.texcoord.x > threshold) {
		color.r = 1.0;
	} else {
		color.b = 1.0;
	}

	// For loop test
	float sum = 0.0;
	for (int i = 0; i < iterations; i = i + 1) {
		sum = sum + 0.1;
	}
	color.g = sum;

	// While loop test
	int count = 0;
	while (count < 5) {
		color.a = color.a - 0.1;
		count = count + 1;
	}

	return color;
}
